# Docker Configuration
DOCKER_USERNAME=your-username  # Your Docker Hub username

# Server Configuration
FLASK_APP=app.py
FLASK_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# USB/IP Configuration
USBIP_HOST=host.docker.internal
USBIP_PORT=3240
USBIP_DEVICE_BUSID=1-1  # 可選，如果不設置則需要手動連接設備

# RIS Configuration
RIS_COM_PORT=1
RIS_DEFAULT_PARAMS_RIS_Case=2
RIS_DEFAULT_PARAMS_FREQ=29.4
RIS_DEFAULT_PARAMS_XI=0
RIS_DEFAULT_PARAMS_YI=0
RIS_DEFAULT_PARAMS_ZI=0
RIS_DEFAULT_PARAMS_THETA_I=0
RIS_DEFAULT_PARAMS_PHI_I=0
RIS_DEFAULT_PARAMS_THETA_R=0
RIS_DEFAULT_PARAMS_PHI_R=0
RIS_DEFAULT_PARAMS_BITS=8
RIS_DEFAULT_PARAMS_NUM_PX=32
RIS_DEFAULT_PARAMS_NUM_PY=32
RIS_DEFAULT_PARAMS_FIG=1
RIS_DEFAULT_PARAMS_ID_PANEL=1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log 