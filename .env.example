# Docker Configuration
DOCKER_USERNAME=your-username  # Your Docker Hub username

# Server Configuration
FLASK_APP=app.py
FLASK_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# USB/IP Configuration
USBIP_HOST=host.docker.internal
USBIP_PORT=3240
USBIP_DEVICE_BUSID=1-1  # 可選，如果不設置則需要手動連接設備

# RIS Configuration
RIS_COM_PORT=3  # 串口號碼，根據實際情況修改
RIS_DEFAULT_PARAMS={
    "RIS_Case": 2,
    "freq": 29.4,
    "xi": 0,
    "yi": 0,
    "zi": 0,
    "theta_i": 0,
    "phi_i": 0,
    "theta_r": 0,
    "phi_r": 0,
    "bits": 1,
    "num_px": 8,
    "num_py": 8,
    "fig": 1,
    "id_panel": "A"
}

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ris_server.log 