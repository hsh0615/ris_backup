# Flask 應用配置
FLASK_APP=app.py
FLASK_ENV=production
# FLASK_DEBUG=0

# 服務器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# MATLAB 配置
MATLAB_ROOT=C:/Program Files/MATLAB/R2023b
MATLAB_TOOLBOX_PATH=YTTEK_YTRS0289_release_2024_v1/release/UART/Tool

# RIS 設備配置
RIS_DEFAULT_COM_PORT=14
RIS_DEFAULT_PANEL_ID=01
RIS_USE_MATLAB=false

# RIS 默認參數
RIS_DEFAULT_FREQ=28.0
RIS_DEFAULT_XI=10.5
RIS_DEFAULT_YI=5.2
RIS_DEFAULT_ZI=2.3
RIS_DEFAULT_BITS=8
RIS_DEFAULT_FIG=3
RIS_DEFAULT_NUM_PX=1
RIS_DEFAULT_NUM_PY=1
RIS_DEFAULT_THETA_I=0
RIS_DEFAULT_PHI_I=0
RIS_DEFAULT_THETA_R=60
RIS_DEFAULT_PHI_R=0
RIS_DEFAULT_CASE=2

# 日誌配置
LOG_LEVEL=INFO
LOG_FILE=ris_server.log
