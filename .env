# Flask 應用配置
FLASK_APP=app.py
FLASK_ENV=production
# FLASK_DEBUG=0
COM_PORT=/dev/ttyUSB1



# RIS 默認參數
RIS_DEFAULT_FREQ=28.0
RIS_DEFAULT_XI=10.5
RIS_DEFAULT_YI=5.2
RIS_DEFAULT_ZI=2.3
RIS_DEFAULT_BITS=8
RIS_DEFAULT_FIG=3
RIS_DEFAULT_NUM_PX=1
RIS_DEFAULT_NUM_PY=1
RIS_DEFAULT_THETA_I=0
RIS_DEFAULT_PHI_I=0
RIS_DEFAULT_THETA_R=60
RIS_DEFAULT_PHI_R=0
RIS_DEFAULT_CASE=2

# 日誌配置
LOG_LEVEL=INFO
LOG_FILE=ris_server.log
